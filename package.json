{
  "name": "contentos-ai",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck --concurrency=2 && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @contentos/db generate",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @contentos/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^10.12.0",
    "mailparser": "^3.9.34",
    "sharp": "^0.35.5",
    "smtp-server": "^3.19.17",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
