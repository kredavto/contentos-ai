# Local development only. Copy to .env; never commit runtime secrets.
NODE_ENV=development
APP_NAME=CONTENTOS AI
APP_URL=http://localhost:3100
DATABASE_URL=postgresql://contentos:local-development-only@localhost:5432/contentos
REDIS_URL=redis://localhost:6379
# Real provider credentials remain unset until configured server-side.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@contentos.test

# disabled (default), openai, or mock (local/test only). Never use mock in production.
AI_PROVIDER=disabled
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional loopback worker liveness port
# WORKER_HEALTH_PORT=3190

# Private S3-compatible bucket; credentials stay on web/worker servers.
STORAGE_PROVIDER=disabled
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true
# S3_ENCRYPTION=AES256
# S3_KMS_KEY_ID=

# Avatar jobs require private storage and explicit enablement. Mock is dev/test only.
AVATAR_PROVIDER=disabled
AVATAR_GENERATION_ENABLED=false
# HEYGEN_API_KEY=

# Video generation executes in the persistent worker, never the BFF.
VIDEO_PROVIDER=disabled
VIDEO_GENERATION_ENABLED=false
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# Development/test mock only: absolute path to a generated MP4 fixture.
# MOCK_VIDEO_FILE=/tmp/contentos-video-fixture.mp4
# Optional timestamped transcription; manual captions need no external provider.
CAPTION_PROVIDER=disabled
CAPTION_MODEL=whisper-1
# Telegram connection checks are read-only. Publishing is a separate workflow.
SOCIAL_PROVIDER=disabled
# Generate independent 32-byte random base64 keys in your secret manager.
# Keep old keys until all stored credentials have been rewrapped.
# CREDENTIAL_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}
# CREDENTIAL_ACTIVE_KEY_ID=v1
