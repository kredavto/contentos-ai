{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "APP_NAME"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "SMTP_URL",
        "EMAIL_FROM",
        "AI_PROVIDER",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "WORKER_HEALTH_PORT",
        "STORAGE_PROVIDER",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_ENCRYPTION",
        "S3_KMS_KEY_ID"
      ]
    }
  }
}
